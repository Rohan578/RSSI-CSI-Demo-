#!/bin/sh
# Refuse to commit a real WiFi password. deploy/fill_wifi_password.sh puts the
# password into config.h for flashing; run it with --clear before committing.
# Enable once per clone:   git config core.hooksPath .githooks
if git diff --cached -U0 -- '*config.h' | grep -E '^\+#define WIFI_PASSWORD' | grep -vq '__WIFI_PASSWORD__'; then
  echo "pre-commit: a config.h with a real WIFI_PASSWORD is staged." >&2
  echo "            Run ./csi-arduino/deploy/fill_wifi_password.sh --clear, then commit again." >&2
  exit 1
fi
