/*
 * ============================================================================
 *  ESP32-C6 SuperMini  -  WiFi + UDP Dummy Data Sender
 * ============================================================================
 *
 *  WHAT THIS DOES
 *    1. Connects to a WiFi network.
 *    2. Every SEND_INTERVAL_MS, builds a small JSON packet of dummy data.
 *    3. Sends that packet over UDP to a server (the Python/Flask app).
 *    4. Reconnects automatically if WiFi drops.
 *
 *  HARDWARE
 *    - ESP32-C6 SuperMini (any ESP32-C6 board should work)
 *
 *  ARDUINO IDE SETUP
 *    - Install "esp32 by Espressif Systems" (version 3.x or newer) in
 *      Boards Manager. Version 3.x is required for ESP32-C6 support.
 *    - Board:              "ESP32C6 Dev Module"
 *    - USB CDC On Boot:    "Enabled"   (otherwise Serial Monitor shows nothing)
 *    - Serial Monitor:     115200 baud
 *
 *  NOTE: The ESP32-C6 only supports 2.4 GHz WiFi. It cannot join a
 *        5 GHz-only network.
 * ============================================================================
 */

#include <WiFi.h>
#include <WiFiUdp.h>


// ============================================================================
//  SECTION 1: USER SETTINGS  -  Change these to match your setup
// ============================================================================

// --- WiFi credentials ---
const char* WIFI_SSID     = "ORBI21";
const char* WIFI_PASSWORD = "yellowsun456";

// --- Server details ---
// The IP address of the computer running server.py.
// Find it with "ipconfig" (Windows) or "ifconfig" / "ip a" (Mac/Linux).
const char*    SERVER_IP   = "192.168.1.100";
const uint16_t SERVER_PORT = 5005;          // Must match UDP_PORT in server.py

// --- Device identity (handy when you have several boards) ---
const char* DEVICE_ID = "esp32c6-01";

// --- Timing ---
const unsigned long SEND_INTERVAL_MS     = 2000;   // How often to send data
const unsigned long WIFI_TIMEOUT_MS      = 15000;  // Give up a connect attempt after this
const unsigned long WIFI_RETRY_DELAY_MS  = 5000;   // Wait before retrying a failed connect

// --- Status LED ---
// Most ESP32-C6 SuperMini boards have a plain LED on GPIO 15.
// If yours is different, change this number. Set to -1 to disable the LED.
const int  STATUS_LED_PIN       = 15;
const bool STATUS_LED_ACTIVE_LOW = false;   // Set true if your LED lights on LOW


// ============================================================================
//  SECTION 2: GLOBAL OBJECTS & STATE  -  Usually no need to change
// ============================================================================

WiFiUDP udp;                         // The UDP "socket" used to send packets
unsigned long lastSendTime = 0;      // Last time (in ms) a packet was sent
uint32_t packetCounter     = 0;      // Counts packets sent since boot


// ============================================================================
//  SECTION 3: HELPER FUNCTIONS
// ============================================================================

// ---------------------------------------------------------------------------
//  setLed()  -  Turns the status LED on or off (handles active-low boards)
// ---------------------------------------------------------------------------
void setLed(bool on) {
  if (STATUS_LED_PIN < 0) return;
  bool level = STATUS_LED_ACTIVE_LOW ? !on : on;
  digitalWrite(STATUS_LED_PIN, level ? HIGH : LOW);
}

// ---------------------------------------------------------------------------
//  connectToWiFi()  -  Tries to join the WiFi network.
//  Returns true if connected, false if it timed out.
// ---------------------------------------------------------------------------
bool connectToWiFi() {
  Serial.printf("\n[WiFi] Connecting to \"%s\" ...\n", WIFI_SSID);

  WiFi.mode(WIFI_STA);              // Station mode = normal WiFi client
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long startTime = millis();
  while (WiFi.status() != WL_CONNECTED) {
    if (millis() - startTime > WIFI_TIMEOUT_MS) {
      Serial.println("[WiFi] Connection timed out.");
      WiFi.disconnect();
      return false;
    }
    setLed(!digitalRead(STATUS_LED_PIN));   // Blink LED while connecting
    Serial.print(".");
    delay(250);
  }

  setLed(true);   // Solid LED = connected
  Serial.println();
  Serial.println("[WiFi] Connected!");
  Serial.print  ("[WiFi] Board IP address: ");
  Serial.println(WiFi.localIP());
  Serial.printf ("[WiFi] Signal strength:  %d dBm\n", WiFi.RSSI());
  return true;
}

// ---------------------------------------------------------------------------
//  ensureWiFiConnected()  -  Call this in loop(). If WiFi dropped, it keeps
//  retrying until the connection is back.
// ---------------------------------------------------------------------------
void ensureWiFiConnected() {
  if (WiFi.status() == WL_CONNECTED) return;

  setLed(false);
  Serial.println("[WiFi] Not connected. Reconnecting...");
  while (!connectToWiFi()) {
    Serial.printf("[WiFi] Retrying in %lu ms...\n", WIFI_RETRY_DELAY_MS);
    delay(WIFI_RETRY_DELAY_MS);
  }
}

// ---------------------------------------------------------------------------
//  buildPayload()  -  Creates the data to send, formatted as JSON text.
//
//  >>> THIS IS THE MAIN PLACE TO EDIT when you replace dummy data with real
//  >>> sensor readings. Add or remove fields here.
// ---------------------------------------------------------------------------
String buildPayload() {
  // ---- Dummy values (replace with real sensor reads later) ----
  float fakeTemperature = 20.0 + random(0, 1000) / 100.0;  // 20.00 - 29.99 C
  float fakeHumidity    = 40.0 + random(0, 2000) / 100.0;  // 40.00 - 59.99 %
  int   fakeButton      = random(0, 2);                     // 0 or 1

  // ---- Build the JSON string ----
  // Format: {"device":"...","counter":1,"uptime_ms":1234,...}
  String json = "{";
  json += "\"device\":\""    + String(DEVICE_ID)            + "\",";
  json += "\"counter\":"     + String(packetCounter)        + ",";
  json += "\"uptime_ms\":"   + String(millis())             + ",";
  json += "\"rssi\":"        + String(WiFi.RSSI())          + ",";
  json += "\"temperature\":" + String(fakeTemperature, 2)   + ",";
  json += "\"humidity\":"    + String(fakeHumidity, 2)      + ",";
  json += "\"button\":"      + String(fakeButton);
  json += "}";

  return json;
}

// ---------------------------------------------------------------------------
//  sendUdpPacket()  -  Sends one text message to the server over UDP.
//  Returns true if the packet was handed to the network successfully.
//
//  NOTE: UDP is "fire and forget" - success here means it was sent, NOT that
//  the server received it. Check the server's output to confirm delivery.
// ---------------------------------------------------------------------------
bool sendUdpPacket(const String& message) {
  if (!udp.beginPacket(SERVER_IP, SERVER_PORT)) {
    Serial.println("[UDP]  ERROR: could not start packet (bad IP/port?)");
    return false;
  }
  udp.print(message);
  if (!udp.endPacket()) {
    Serial.println("[UDP]  ERROR: packet failed to send");
    return false;
  }
  return true;
}


// ============================================================================
//  SECTION 4: setup()  -  Runs once at power-on / reset
// ============================================================================
void setup() {
  Serial.begin(115200);
  delay(1500);   // Give the USB serial port a moment to come up

  Serial.println("\n=========================================");
  Serial.println("  ESP32-C6 UDP Sender - starting up");
  Serial.println("=========================================");

  if (STATUS_LED_PIN >= 0) {
    pinMode(STATUS_LED_PIN, OUTPUT);
    setLed(false);
  }

  randomSeed(esp_random());   // Hardware random seed for the dummy data

  ensureWiFiConnected();

  udp.begin(0);   // 0 = let the board pick any free local port for sending
  Serial.printf("[UDP]  Sending to %s:%u every %lu ms\n",
                SERVER_IP, SERVER_PORT, SEND_INTERVAL_MS);
}


// ============================================================================
//  SECTION 5: loop()  -  Runs over and over forever
// ============================================================================
void loop() {
  ensureWiFiConnected();   // Reconnect if WiFi dropped

  // Send a packet once every SEND_INTERVAL_MS (non-blocking timer)
  if (millis() - lastSendTime >= SEND_INTERVAL_MS) {
    lastSendTime = millis();
    packetCounter++;

    String payload = buildPayload();

    if (sendUdpPacket(payload)) {
      Serial.print("[UDP]  Sent: ");
      Serial.println(payload);
    }
  }

  // You can add other non-blocking tasks here.
}

